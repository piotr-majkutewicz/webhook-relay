{
  "name": "webhook-relay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reliable webhook intake and forwarding: signatures, idempotency, retries, dead-letter, admin panel.",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev --port 8787 --test-scheduled",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "demo": "node scripts/demo.mjs",
    "db:migrate:local": "wrangler d1 migrations apply webhook-relay --local",
    "db:migrate:remote": "wrangler d1 migrations apply webhook-relay --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
