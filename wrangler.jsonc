{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webhook-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webhook-relay",
      // Replace with the id printed by: npx wrangler d1 create webhook-relay
      // (local development works with any value).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "MAX_BODY_BYTES": "262144",
    "MAX_ATTEMPTS": "6",
    "RETRY_BASE_SECONDS": "30",
    "RETRY_MAX_SECONDS": "3600",
    "DELIVERY_TIMEOUT_MS": "10000",
    "BATCH_SIZE": "10"
  },
  // Public demo: `wrangler deploy --env demo` creates a separate Worker named
  // webhook-relay-demo with its OWN database. Nothing here is inherited from the
  // top level except main and compatibility_date, so the demo never shares a
  // database, secrets or vars with a real deployment.
  "env": {
    "demo": {
      "routes": [{ "pattern": "relay.piotrmajkutewicz.pl", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "webhook-relay-demo",
          // Replace with the id printed by: npx wrangler d1 create webhook-relay-demo
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "DEMO_MODE": "true",
        "DEMO_TTL_HOURS": "24",
        "DEMO_MAX_EVENTS": "300",
        "DEMO_RATE_WINDOW_SECONDS": "3600",
        "DEMO_RATE_PER_IP": "20",
        "DEMO_RATE_GLOBAL": "200",
        "MAX_ATTEMPTS": "5",
        "RETRY_BASE_SECONDS": "5",
        "RETRY_MAX_SECONDS": "10",
        "DELIVERY_TIMEOUT_MS": "5000",
        "BATCH_SIZE": "10"
      }
    }
  }
}
